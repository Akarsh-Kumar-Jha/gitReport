# ==========================================
# CodeScope Monorepo Root GitIgnore Configuration
# Covers both client/ and server/ directories
# ==========================================

# Node Modules & Dependencies
node_modules/
server/node_modules/
client/node_modules/

# Environment Files & Secrets
.env
.env.local
.env.*.local
server/.env
client/.env
client/.env.local

# Production Build & Dist Outputs
dist/
build/
client/dist/
client/build/

# Log Files & Debugging Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
server/*.log

# OS & Editor System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary & Cache Directories
.cache/
.vite/
client/.vite/
scratch/
tmp/
